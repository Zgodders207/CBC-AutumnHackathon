# Copy to .env (in server/ or the repo root). .env is git-ignored. Never commit a real key.
ANTHROPIC_API_KEY=
# idea.md 11c costs assume Sonnet 5.5. The engine defaults to Opus 5.5 if this is unset.
CLAUDE_MODEL=claude-sonnet-5-5
# Alternatives to Anthropic. With several keys set, AI_PROVIDER (anthropic | gemini | groq) picks one;
# if it is empty the first key found wins, in that order.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PORT=8787
# Follow-up rounds after the first intake round. Stage 1 = 1, stage 2 = up to 3 (idea.md 11b).
MAX_ROUNDS=1
# Cost guards. Every AI call costs real money.
AI_CALLS_PER_IP_PER_HOUR=30
AI_CALLS_PER_DAY=300
